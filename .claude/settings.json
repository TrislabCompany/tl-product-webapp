{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet test src/App.slnx*)",
      "Bash(pnpm --dir web test*)",
      "Bash(pnpm --dir web lint*)"
    ],
    "ask": [
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/platform.yaml)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  }
}
