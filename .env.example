# The settings of the app with local values, for docker compose. Copy this file
# to .env, which git ignores. In a stamp, the platform sets the same names
# (docs/configuration.md). Never put a real password or key here.

# The local Postgres container.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Read by api and migrator. In a stamp, the stamp's postgres service sets it.
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Set by the stamp; dev, test or prod there.
PLATFORM_ENVIRONMENT=local

# The key that signs the sign-in tokens, and the first administrator's password
# (admin@example.com, TenancyOptions in src/Api/appsettings.json). Local values
# only: the stamp's Key Vault sets the real ones as the secrets jwt-signing-key
# and seed-admin-password.
JWT_SIGNING_KEY=local-only-signing-key-change-me-0123456789
SEED_ADMIN_PASSWORD=Local-Admin-Pa55word

# Seeds the test data (a demo user, user@example.com / Password123!, and sample
# items). Only where there is no real data: a sandbox or a local run.
SEED_TEST_DATA=true

# The optional staff area under /admin (docs/staff-area.md): the API maps it, and
# the front end shows its route. Off by default in a stamp; on in the sandbox and
# locally.
StaffArea__Enabled=true
PUBLIC_STAFF_AREA=true

# A setting that reaches the browser through /config.json. Every setting whose
# name starts with PUBLIC_ does; never put a secret in one. The language the app
# opens in, en-US or sl-SI; empty means the browser's.
PUBLIC_DEFAULT_LANGUAGE=
