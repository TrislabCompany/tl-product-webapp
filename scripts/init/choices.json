{
  "_comment": "What init-product may remove. A line of a file that ends with `module:<name>` or `feature:<name>` belongs to that choice; `paths` are the files that belong only to it. `needs` names the modules a choice cannot work without. The template-only files are not listed here: they come from template-manifest.yaml.",
  "modules": {
    "identity": {
      "required": true,
      "paths": []
    },
    "auditing": {
      "paths": []
    },
    "files": {
      "paths": []
    },
    "notifications": {
      "paths": []
    },
    "webhooks": {
      "paths": []
    },
    "invoice-documents": {
      "paths": [
        "src/Migrator/InvoiceDocumentsDemoData.cs",
        "src/Tests/Integration.Tests/InvoiceDocumentsTests.cs",
        "web/src/features/invoice-documents/**"
      ]
    }
  },
  "features": {
    "staff-area": {
      "needs": [
        "identity"
      ],
      "paths": [
        "src/Api/Features/Staff/**",
        "src/Migrator/StaffRoleSeeder.cs",
        "src/Tests/Integration.Tests/StaffAreaTests.cs",
        "web/src/features/admin/**",
        "web/src/locales/*/admin.json",
        "docs/staff-area.md",
        "web/src/features/invoice-documents/**"
      ]
    }
  }
}
