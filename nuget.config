<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org, and the Trislab framework packages on GitHub Packages. GitHub Packages asks for a token even
       for a public package: CI passes the workflow's token as PACKAGES_TOKEN, a developer sets a personal
       token with read:packages (docs/getting-started.md). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="trislab" value="https://nuget.pkg.github.com/TrislabCompany/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="trislab">
      <package pattern="Trislab.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <trislab>
      <add key="Username" value="trislab" />
      <add key="ClearTextPassword" value="%PACKAGES_TOKEN%" />
    </trislab>
  </packageSourceCredentials>
</configuration>
