<Project>
  <!-- Build settings every project under src/ shares. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>

		<!-- Finbuckle.MultiTenant 11 asks for its EULA to be accepted; without it the build warns FBMT0001. -->
		<AcceptFinbuckleEULA>true</AcceptFinbuckleEULA>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet audit: every package, direct and transitive, against the advisories of every severity. A finding stays
         a warning (NU1901 to NU1904), so a new advisory never fails an unrelated build; the daily audit catches it
         (docs/getting-started.md, section "Vulnerable dependencies"). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The chiseled runtime image has no ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Proprietary: LICENSE. -->
    <Company>Trislab d.o.o.</Company>
    <Copyright>Copyright (c) 2026 Trislab d.o.o. All rights reserved.</Copyright>
    <!-- Without ICU only the invariant culture may be created by default, and the framework's request localization
         creates named cultures such as en-US, so the API would not start (the framework's own host sets the same). -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>
</Project>
